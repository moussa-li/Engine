    // 指定clangd的路径，如果系统环境变量中已经有clangd，可以省略
    "clangd.path": "C://msys64//mingw64//bin//clangd.exe",
    // clangd启动参数，常用参数如下：
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/win-clangd-debug",
        "--header-insertion=never", // 禁止自动插入头文件
        "--clang-tidy", // 启用clang-tidy检查
        "--completion-style=detailed", // 详细的代码补全
        "--background-index" // 后台索引，提高响应速度
    ],
    "editor.formatOnSave": true,
    "files.encoding": "utf8",
    "cmake.testConfig": {
        "run": "ctest --output-on-failure",
        "debug": "win-clangd-debug-test"
    },
    "C_Cpp.errorSquiggles": "disabled"
