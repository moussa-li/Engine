{
    "version": 8,
    "configurePresets": [
        {
            "name": "mingw64-clangd-debug",
            "displayName": "Clang 19.1.7 x86_64-w64-windows-gnu (mingw64)",
            "description": "using complie C = C:\\msys64\\mingw64\\bin\\clang.exe, CXX = C:\\msys64\\mingw64\\bin\\clang++.exe",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/clang++.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang 19.1.7 x86_64-w64-windows-gnu (clang64)",
            "description": "using complie C = C:/msys64/clang64/bin/clang.exe, CXX = C:/msys64/clang64/bin/clang++.exe",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/clang64/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/clang64/bin/clang++.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-ninja-debug",
            "displayName": "Ninja using MSVC Debug",
            "description": "",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_NINJA_CMCLDEPS_RC": "0"
            }
        },
        {
            "name": "win-ninja-release",
            "displayName": "Ninja using MSVC Release",
            "description": "",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "PATH": "$env{VCToolsInstallDir}bin/Hostx64/x64;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_NINJA_CMCLDEPS_RC": "0"
            }
        },
        {
            "name": "win-ninja-relwithdebinfo",
            "displayName": "Ninja using MSVC RelWithDebInfo",
            "description": "",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "PATH": "$env{VCToolsInstallDir}bin/Hostx64/x64;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "/MD /Zi /Od /DNDEBUG",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/MD /Zi /Od /DNDEBUG",
                "CMAKE_NINJA_CMCLDEPS_RC": "0"
            }
        },
        {
            "name": "win-ninja-relwithdebinfo-occt",
            "displayName": "Ninja MSVC RelWithDebInfo + OpenCASCADE 7.5",
            "description": "GeometryEngine built with the OCCT 7.5 kernel adapter. Expects the OCCT 7.5 prebuilt package under 3rd/occt-7.5.0 (adjust OpenCASCADE_DIR / OpenCASCADE_THIRDPARTY_DLL_DIRS if installed elsewhere). Prebuilt OCCT binaries are release-only, so use a release-like MSVC config (/MD); a Debug (/MDd) build would mix CRTs and crash.",
            "inherits": "win-ninja-relwithdebinfo",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_GEOMETRY_KERNEL": "OCCT",
                "OpenCASCADE_DIR": "${sourceDir}/3rd/occt-7.5.0/opencascade-7.5.0/cmake",
                "OpenCASCADE_THIRDPARTY_DLL_DIRS": "${sourceDir}/3rd/occt-7.5.0/tbb_2017.0.100/bin/intel64/vc14"
            }
        },
        {
            "name": "使用工具链文件配置预设",
            "displayName": "使用工具链文件配置预设",
            "description": "设置 Ninja 生成器、版本和安装目录",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
